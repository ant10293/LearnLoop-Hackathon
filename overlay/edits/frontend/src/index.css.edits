+/* Loading placeholders, from vision-test-bench */
@@ -763,5 +495,5 @@
+.thumb-empty > .bone-fill, .film-empty > .bone-fill { height: auto; align-self: stretch; }
+.film-empty { overflow: hidden; }
+/* A real control keeps its own height, so only the text-sized height and inline display are undone. */
+.field.bone { display: block; width: 100%; height: auto; }
+.step header .field.bone { width: auto; }
