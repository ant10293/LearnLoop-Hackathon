+def _file_gone(video: VideoAsset) -> bool:
+    """True when the row's original is no longer on disk, whether copied in or referenced."""
+    if not video.stored_path:
+        return False
+    try:
+        return not resolve_stored(video.stored_path).is_file()
+    except ValueError:
+        return True
