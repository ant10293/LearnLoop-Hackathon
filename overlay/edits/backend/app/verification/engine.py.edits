+    alignment = alignment or {}
+    if alignment.get("status") != "matched" or alignment.get("outcome") in {"attempted", "failed"}:
+        return []
+    end = alignment.get("end")
+    if end is None:
+        end = alignment.get("time")
+    return [float(end)] if end is not None else []
+
